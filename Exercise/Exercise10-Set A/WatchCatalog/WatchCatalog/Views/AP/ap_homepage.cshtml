@{
    ViewData["Title"] = "Home Page";
}

<section class="featured">
    <div class="featured-list">
        <a class="featured-card-link" asp-area="" asp-controller="AP" asp-action="RoyalOak">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Audemars Piguet/Audemars-Piguet-Royal-Oak.jpg" alt="Royal Oak">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Audemars Piguet Royal Oak</h3>
                    <p class="developer">by Audemars Piguet</p>
                    <p class="location"> Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱2,500,000</p>
                    <div class="specs">
                        <div><strong>41 mm</strong> Case Diameter</div>
                        <div><strong>10.5 mm</strong> Thickness</div>
                        <div><strong>Automatic</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="AP" asp-action="Offshore">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Audemars Piguet/Royal Oak Offshore.jpg" alt="Offshore">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Audemars Piguet Royal Oak Offshore</h3>
                    <p class="developer">by Audemars Piguet</p>
                    <p class="location"> Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱3,500,000</p>
                    <div class="specs">
                        <div><strong>43 mm</strong> Case Diameter</div>
                        <div><strong>14.4 mm</strong> Thickness</div>
                        <div><strong>Chronograph</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</section>