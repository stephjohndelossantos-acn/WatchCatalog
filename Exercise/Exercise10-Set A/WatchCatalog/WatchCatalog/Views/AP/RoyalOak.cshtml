@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Audemars Piguet/Audemars-Piguet-Royal-Oak.jpg"
         alt="Royal Oak">
    <div class="detail-header">
        <h1>Audemars Piguet Royal Oak (15510ST)</h1>
        <p class="price">₱2,500,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Audemars Piguet Royal Oak (15510ST)" asp-route-brand="Audemars Piguet">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>50 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>41 mm / 10.5 mm</strong></div>
        <div><span>Movement/Chronograph</span><strong>Automatic (Self-Winding)</strong></div>
        <div><span>Caliber</span><strong>AP Caliber 4302</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Audemars Piguet Royal Oak is one of the most iconic luxury sports watches ever created, recognizable for its octagonal bezel, exposed screws, and integrated bracelet design. Designed by Gérald Genta and introduced in 1972, the Royal Oak revolutionized luxury watchmaking by combining stainless steel construction with high-end finishing. Powered by the in-house Caliber 4302 automatic movement, the 41 mm Royal Oak delivers exceptional craftsmanship, precision, and timeless elegance, making it one of the most sought-after luxury watches in the world.</p>
    </div>

</div>