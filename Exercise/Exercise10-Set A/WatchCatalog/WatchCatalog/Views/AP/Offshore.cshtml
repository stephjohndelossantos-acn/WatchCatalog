    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Audemars Piguet Royal Oak Offshore(15510ST)" asp-route-brand="Audemars Piguet">Purchase this watch</a>
