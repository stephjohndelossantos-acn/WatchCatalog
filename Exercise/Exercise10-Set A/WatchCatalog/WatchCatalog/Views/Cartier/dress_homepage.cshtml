@{
    ViewData["Title"] = "Home Page";
}

<section class="featured">
    <div class="featured-list">
        <a class="featured-card-link" asp-area="" asp-controller="Cartier" asp-action="Tank">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Cartier/Cartier Tank.jpg" alt="Tank">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Cartier Tank Must</h3>
                    <p class="developer">by Cartier</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Dress Watch</p>
                    <p class="price">₱420,000</p>
                    <div class="specs">
                        <div><strong>33 mm</strong> Case Diameter</div>
                        <div><strong>7.5 mm</strong> Thickness</div>
                        <div><strong>Quartz</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Rolex" asp-action="Obsidian">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/Rolex sapphire-covered obsidian dial.jpg" alt="Obsidian">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Rolex Sapphire Covered Obsidian Dial</h3>
                    <p class="developer">by Rolex</p>
                    <p class="location"> Daytona 126599TSA</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱70,000,000</p>
                    <div class="specs">
                        <div><strong>40 mm</strong> Case Diameter</div>
                        <div><strong>12.2 mm</strong> Thickness</div>
                        <div><strong>Rolex Caliber 3255</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Cartier" asp-action="Santos">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Cartier/Cartier Santos.jpg" alt="Santos">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Cartier Santos</h3>
                    <p class="developer">by Cartier</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Dress Watch</p>
                    <p class="price">₱600,000</p>
                    <div class="specs">
                        <div><strong>39.8 mm</strong> Case Diameter</div>
                        <div><strong>8 mm</strong> Thickness</div>
                        <div><strong>Automatic</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</section>