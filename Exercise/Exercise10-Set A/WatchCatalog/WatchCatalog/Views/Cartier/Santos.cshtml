@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Cartier/Cartier Santos.jpg"
         alt="Cartier Santos">
    <div class="detail-header">
        <h1>Cartier Santos</h1>
        <p class="price">₱600,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Cartier Santos" asp-route-brand="Cartier">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>33.7 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>39.8 mm / 8 mm</strong></div>
        <div><span>Movement/Chronograph</span><strong>Automatic</strong></div>
        <div><span>Caliber</span><strong>Cartier Caliber 1847 MC</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Cartier Santos is a distinguished dress watch known for its elegant design and precision. Featuring a 39.8 mm stainless steel case, a fixed bezel, and Cartier's Caliber 1847 MC automatic movement, it offers accurate timekeeping and sophisticated style. Celebrated for its iconic rectangular case, luxurious finish, and association with refined watchmaking, the Santos remains a favorite among watch enthusiasts and collectors worldwide.</p>
    </div>

</div>