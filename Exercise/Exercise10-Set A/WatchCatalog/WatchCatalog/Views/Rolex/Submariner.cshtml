@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex submariner.jpg"
         alt="Rolex Submariner">
    <div class="detail-header">
        <h1>Rolex Submariner</h1>
        <p class="price">₱650,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Rolex Submariner" asp-route-brand="Rolex">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>48.5 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>41 mm/ 12.2 mm (approximate)</strong></div>
        <div><span>Movement/Chronograph</span><strong>Perpetual, Mechanical, Self-Winding</strong></div>
        <div><span>Caliber</span><strong>Rolex Caliber 3235 (modern Submariner movement)</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Rolex Submariner Date 126610LN is the world's most iconic luxury dive watch, featuring a 41 mm Oystersteel case, a black Cerachrom ceramic bezel, and a highly legible black dial with Chromalight luminescent markers. Powered by Rolex's in-house Caliber 3235 automatic movement with a 70-hour power reserve, it is water-resistant to 300 meters (1,000 feet) and built for both professional diving and everyday wear. Combining exceptional durability, timeless design, and legendary Rolex craftsmanship, the Submariner remains the benchmark against which all dive watches are measured.</p>
    </div>

</div>