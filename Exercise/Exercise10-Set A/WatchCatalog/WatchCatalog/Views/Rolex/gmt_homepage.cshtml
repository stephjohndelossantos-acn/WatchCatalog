@{
    ViewData["Title"] = "Home Page";
}

<section class="featured">
    <div class="featured-list">
        <a class="featured-card-link" asp-area="" asp-controller="Rolex" asp-action="Seiko">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/seiko gmt.jpg" alt="Seiko GMT">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Seiko 5 Sports GMT</h3>
                    <p class="developer">by Seiko</p>
                    <p class="location">Seiko 5 Sports GMT</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱28,790</p>
                    <div class="specs">
                        <div><strong>42.5 mm</strong> Case Diameter</div>
                        <div><strong>13.6 mm</strong> Thickness</div>
                        <div><strong>Seiko Caliber 4R34</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Rolex" asp-action="GMT">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex gmt.png" alt="GMT">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Rolex GMT</h3>
                    <p class="developer">by Rolex</p>
                    <p class="location">GMT-Master II 126710BLRO</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱ 1,550,000</p>
                    <div class="specs">
                        <div><strong>40 mm</strong> Case Diameter</div>
                        <div><strong>12.2 mm</strong> Thickness</div>
                        <div><strong>Rolex Caliber 3285</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</section>