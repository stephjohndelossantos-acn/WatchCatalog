@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex-cosmograph-daytona.jpg"
         alt="Rolex Daytona">
    <div class="detail-header">
        <h1>Rolex Cosmograph Daytona</h1>
        <p class="price">₱3,280,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Rolex Cosmograph Daytona" asp-route-brand="Rolex">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>47.5 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>40 mm/ 12.2 mm (approximate)</strong></div>
        <div><span>Movement/Chronograph</span><strong>Chronograph</strong></div>
        <div><span>Caliber</span><strong>Rolex Caliber 4131 (modern Daytona movement)</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Rolex Cosmograph Daytona is an iconic luxury sports chronograph originally designed for professional racing drivers. Featuring a 40 mm Oystersteel case, a black Cerachrom tachymeter bezel, and Rolex's in-house Caliber 4131 automatic movement, it delivers exceptional precision, reliability, and a 72-hour power reserve. Its distinctive three-register dial allows accurate timekeeping of racing events while maintaining the timeless elegance and durability that have made the Daytona one of the most coveted watches in the world.</p>
    </div>

</div>