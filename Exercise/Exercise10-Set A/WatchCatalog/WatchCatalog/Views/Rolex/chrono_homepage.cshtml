@{
    ViewData["Title"] = "Home Page";
}

<section class="featured">
    <div class="featured-list">
        <a class="featured-card-link" asp-area="" asp-controller="Rolex" asp-action="Daytona">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex-cosmograph-daytona.jpg" alt="Daytona">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Rolex Cosmograph Daytona</h3>
                    <p class="developer">by Rolex</p>
                    <p class="location">Cosmograph Daytona 116500LN</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱ 3,500,000</p>
                    <div class="specs">
                        <div><strong>40 mm</strong> Case Diameter</div>
                        <div><strong>12.2 mm</strong> Thickness</div>
                        <div><strong>Rolex Caliber 4131</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Omega" asp-action="Speedmaster">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/omega-speedmaster.jpg" alt="Speedmaster">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Omega Speedmaster</h3>
                    <p class="developer">by Omega</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Chronograph Watch</p>
                    <p class="price">₱ 450,000</p>
                    <div class="specs">
                        <div><strong>42 mm</strong> Case Diameter</div>
                        <div><strong>13.5 mm</strong> Thickness</div>
                        <div><strong>Omega Caliber 3861</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</section>