@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/Rolex sapphire-covered obsidian dial.jpg"
         alt="Rolex Obsidian">
    <div class="detail-header">
        <h1>Rolex Sapphire Covered Obsidian Dial</h1>
        <p class="price">₱70,000,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Rolex Sapphire Covered Obsidian Dial" asp-route-brand="Rolex">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>47.5 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>40 mm/ 11.9 mm (approximate)</strong></div>
        <div><span>Movement/Chronograph</span><strong>Automatic / Self-winding</strong></div>
        <div><span>Caliber</span><strong>Rolex Caliber 4131 (modern Daytona movement)</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>
            A luxury Rolex Daytona chronograph crafted in 18k white gold, featuring a silver sheen obsidian
            dial and a bezel set with blue sapphires. The Rolex Cosmograph Daytona 126599TSA is an ultra-exclusive
            Daytona featuring a 40mm 18k white
            gold case, a silver sheen obsidian stone dial, a bezel set with 36 baguette-cut blue sapphires,
            and diamond-set case sides. Combining Rolex's legendary chronograph functionality with high
            jewelry craftsmanship, this off-catalogue model is among the rarest and most collectible
            modern Daytonas.
        </p>
    </div>

</div>