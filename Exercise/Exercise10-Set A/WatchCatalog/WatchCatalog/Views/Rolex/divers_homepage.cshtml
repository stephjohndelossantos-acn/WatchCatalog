@{
    ViewData["Title"] = "Home Page";
}

<section class="featured">
    <div class="featured-list">
        <a class="featured-card-link" asp-area="" asp-controller="Rolex" asp-action="Submariner">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex submariner.jpg" alt="Submariner">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Rolex Submariner</h3>
                    <p class="developer">by Rolex</p>
                    <p class="location">Submariner Date 126610LN</p>
                    <hr class="divider">
                    <p class="property-type">Watch</p>
                    <p class="price">₱ 650,000</p>
                    <div class="specs">
                        <div><strong>41 mm</strong> Case Diameter</div>
                        <div><strong>12.2 mm</strong> Thickness</div>
                        <div><strong>Rolex Caliber 3235</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Omega" asp-action="Seamaster">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/omega diver.jpg" alt="Omega Diver">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Omega Seamaster</h3>
                    <p class="developer">by Omega</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Diver Watch</p>
                    <p class="price">₱ 380,000</p>
                    <div class="specs">
                        <div><strong>42 mm</strong> Case Diameter</div>
                        <div><strong>14 mm</strong> Thickness</div>
                        <div><strong>Omega Caliber 8800</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>

    </div>
</section>