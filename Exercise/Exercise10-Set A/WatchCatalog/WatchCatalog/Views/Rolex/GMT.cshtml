@{
    ViewData["Title"] = "Home Page";
}
<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex gmt.png"
         alt="Rolex GMT">
    <div class="detail-header">
        <h1>Rolex GMT</h1>
        <p class="price">₱1,550,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Rolex GMT" asp-route-brand="Rolex">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>48.5 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>42 mm/ 12.2 mm (approximate)</strong></div>
        <div><span>Movement/Chronograph</span><strong>Perpetual, Mechanical, Self-Winding</strong></div>
        <div><span>Caliber</span><strong>Rolex Caliber 3285 (modern GMT movement)</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Rolex GMT-Master II 126710BLRO, popularly known as the "Pepsi" due to its distinctive red and blue Cerachrom bezel, is a luxury travel watch designed to display multiple time zones simultaneously. Featuring a 40 mm Oystersteel case, an additional 24-hour GMT hand, and Rolex's Caliber 3285 automatic movement with a 70-hour power reserve, it allows travelers to track local time and a second time zone at a glance. Combining exceptional durability, precision, and iconic design, the GMT-Master II is one of Rolex's most sought-after sports watches and a favorite among frequent travelers and watch enthusiasts.</p>
    </div>

</div>