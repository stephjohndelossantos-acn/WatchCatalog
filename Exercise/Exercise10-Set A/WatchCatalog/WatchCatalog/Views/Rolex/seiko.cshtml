@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/seiko gmt.jpg"
         alt="Seiko GMT">
    <div class="detail-header">
        <h1>Seiko 5 Sports GMT (SSK001)</h1>
        <p class="price">₱28,790</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Seiko 5 Sports GMT (SSK001)" asp-route-brand="Seiko">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>47.5 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>42.5 mm/ 13.6 mm</strong></div>
        <div><span>Movement/Chronograph</span><strong>Automatic with Manual Winding GMT Movement</strong></div>
        <div><span>Caliber</span><strong>Seiko Caliber 4R34</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Seiko 5 Sports GMT (SSK001) is a versatile and reliable sports watch, featuring a 42.5 mm stainless steel case, a rotating bezel, and Seiko's in-house Caliber 4R34 automatic movement. It offers excellent precision and a power reserve of approximately 41 hours. The watch's distinctive dial and GMT functionality make it ideal for travelers and watch enthusiasts alike, combining practicality with timeless style.</p>
    </div>

</div>