@model WatchCatalog.Models.Purchase
@{
    ViewData["Title"] = "Purchase Details";
}

<div class="mt-4">
    <h2>Purchase Details</h2>

    <dl class="row">
        <dt class="col-sm-3">Watch Name</dt>
        <dd class="col-sm-9">@Model.WatchName</dd>

        <dt class="col-sm-3">Brand</dt>
        <dd class="col-sm-9">@Model.Brand</dd>

        <dt class="col-sm-3">Purchase Date</dt>
        <dd class="col-sm-9">@Model.PurchaseDate.ToString("yyyy-MM-dd")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Update</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
