@model IEnumerable<WatchCatalog.Models.Purchase>
@{
    ViewData["Title"] = "Purchases";
}

<div class="mt-4">
    <h2>Purchases</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Purchase</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Watch Name</th>
                <th>Brand</th>
                <th>Purchase Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.WatchName</td>
                <td>@item.Brand</td>
                <td>@item.PurchaseDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
