@{
    ViewData["Title"] = "Home Page";
}
<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/seamaster.jpg"
         alt="Omega Seamaster">
    <div class="detail-header">
        <h1>Omega Seamaster</h1>
        <p class="price">₱450,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Omega Seamaster" asp-route-brand="Omega">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>49.9 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>42 mm/ 13.2 mm (approximate)</strong></div>
        <div><span>Movement/Chronograph</span><strong>Automatic, Co‑Axial Master Chronometer</strong></div>
        <div><span>Caliber</span><strong>Omega Caliber 8800 (Co‑Axial Master Chronometer movement)</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Omega Seamaster is a renowned dive watch with a rich history in underwater exploration. Featuring a 42 mm stainless steel case, a unidirectional rotating bezel, and Omega's Caliber 3861 automatic movement with a 50-hour power reserve, it offers precise timekeeping and robust performance. Renowned for its durability, iconic design, and association with professional diving, the Seamaster remains a favorite among watch enthusiasts and collectors worldwide.</p>
    </div>

</div>