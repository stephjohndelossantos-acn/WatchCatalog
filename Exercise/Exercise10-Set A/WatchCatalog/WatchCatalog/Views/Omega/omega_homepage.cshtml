@{
    ViewData["Title"] = "Home Page";
}

<section class="featured">
    <div class="featured-list">
        <a class="featured-card-link" asp-area="" asp-controller="Omega" asp-action="Speedmaster">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/omega-speedmaster.jpg" alt="Speedmaster">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Omega Speedmaster</h3>
                    <p class="developer">by Omega</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Chronograph Watch</p>
                    <p class="price">₱ 450,000</p>
                    <div class="specs">
                        <div><strong>42 mm</strong> Case Diameter</div>
                        <div><strong>13.5 mm</strong> Thickness</div>
                        <div><strong>Omega Caliber 3861</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Omega" asp-action="Seamaster">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/seamaster.jpg" alt="Seamaster">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Omega Seamaster</h3>
                    <p class="developer">by Omega</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Diver Watch</p>
                    <p class="price">₱ 380,000</p>
                    <div class="specs">
                        <div><strong>42 mm</strong> Case Diameter</div>
                        <div><strong>14 mm</strong> Thickness</div>
                        <div><strong>Omega Caliber 8800</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
        <a class="featured-card-link" asp-area="" asp-controller="Omega" asp-action="Constellation">
            <div class="featured-card">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/constellation.jpg" alt="Constellation">
                <div class="featured-info">
                    <span class="badge"> FEATURED</span>
                    <h3>Omega Constellation</h3>
                    <p class="developer">by Omega</p>
                    <p class="location">Switzerland</p>
                    <hr class="divider">
                    <p class="property-type">Dress Watch</p>
                    <p class="price">₱ 420,000</p>
                    <div class="specs">
                        <div><strong>41 mm</strong> Case Diameter</div>
                        <div><strong>12 mm</strong> Thickness</div>
                        <div><strong>Omega Caliber 8900</strong> Movement</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</section>