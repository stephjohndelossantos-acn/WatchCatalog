@{
    ViewData["Title"] = "Home Page";
}

<div class="detail-wrap">
    <img class="main-image" src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/omega/constellation.jpg"
         alt="Omega Constellation">
    <div class="detail-header">
        <h1>Omega Constellation</h1>
        <p class="price">₱420,000</p>
    </div>
    <div class="mb-3">
        <a class="btn btn-primary" asp-controller="Purchase" asp-action="Create" asp-route-watchName="Omega Constellation" asp-route-brand="Omega">Purchase this watch</a>
    </div>
    <div class="detail-specs">
        <div><span>Height</span><strong>44 mm</strong></div>
        <div><span>Diameter/Thickness</span><strong>41 mm/ 12 mm (approximate)</strong></div>
        <div><span>Movement/Chronograph</span><strong>Automatic, Co‑Axial Master Chronometer</strong></div>
        <div><span>Caliber</span><strong>Omega Caliber 8900 (Co‑Axial Master Chronometer movement)</strong></div>
    </div>
    <div class="detail-desc">
        <h2>Description</h2>
        <p>The Omega Constellation is a distinguished dress watch known for its elegant design and precision. Featuring a 42 mm stainless steel case, a fixed bezel, and Omega's Caliber 8800 automatic movement with a 50-hour power reserve, it offers accurate timekeeping and sophisticated style. Celebrated for its iconic "Griffes" or claws, luxurious finish, and association with refined watchmaking, the Constellation remains a favorite among watch enthusiasts and collectors worldwide.</p>
    </div>

</div>