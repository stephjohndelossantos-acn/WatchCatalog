@{
    ViewData["Title"] = "Home Page";
}

<section class="hero container-fluid px-0">
    <div class="hero-media">
        <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/GIF Background.gif" alt="" class="hero-gif">
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
        <h1>FIND YOUR WATCH</h1>
        <p>Discover timeless craftsmanship and exceptional precision with our curated collection of luxury timepieces.</p>
    </div>
</section>

<section class="featured container">
    <h2 class="text-center">Most Prestigious</h2>
    <a class="featured-card-link" asp-area="" asp-controller="Rolex" asp-action="Obsidian">
        <div class="featured-card row g-4 align-items-stretch">
            <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/Rolex sapphire-covered obsidian dial.jpg"
                 alt="Featured Watch">
            <div class="featured-info">
                <span class="badge"> MOST EXPENSIVE</span>
                <h3>Rolex Sapphire Obsidian Dial</h3>
                <p class="developer">by Rolex</p>
                <p class="location">Switzerland</p>
                <hr class="divider">
                <p class="property-type">Watch</p>
                <p class="price">>₱70,000,000</p>
                <div class="specs">
                    <div><strong>40 mm</strong> Case Diameter</div>
                    <div><strong>12.2 mm</strong> Thickness</div>
                    <div><strong>Rolex Caliber 3255</strong> Movement</div>
                </div>
            </div>
        </div>
    </a>
</section>

<section class="properties">
    <h2>Rolex</h2>
    <div class="property-grid-2">
        <a class="property-card" asp-area="" asp-controller="Rolex" asp-action="Submariner">
            <div class="thumb-wrap">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex submariner.jpg"
                     alt="Rolex Submariner">
                <span class="featured-badge"> FEATURED</span>
            </div>
            <div class="card-body">
                <p class="price">₱ 650,000</p>
                <p class="title">Rolex Submariner</p>
                <p class="location">by Rolex</p>
                <p class="sqm">41 mm</p>
                <p class="by">Rolex Caliber 3255</p>
            </div>
        </a>

        <a class="property-card" asp-area="" asp-controller="Rolex" asp-action="Daytona">
            <div class="thumb-wrap">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex-cosmograph-daytona.jpg"
                     alt="Rolex Cosmograph Daytona">
                <span class="featured-badge"> FEATURED</span>
            </div>
            <div class="card-body">
                <p class="price">₱ 3,500,000</p>
                <p class="title">Rolex Cosmograph Daytona</p>
                <p class="location">by Rolex</p>
                <p class="sqm">40 mm</p>
                <p class="by">Rolex Caliber 4131</p>
            </div>
        </a>

        <a class="property-card" asp-area="" asp-controller="Rolex" asp-action="GMT">
            <div class="thumb-wrap">
                <img src="https://mystorageaccount031402.blob.core.windows.net/watchcatalog/rolex/rolex gmt.png"
                     alt="Rolex GMT-Master II">
                <span class="featured-badge"> FEATURED</span>
            </div>
            <div class="card-body">
                <p class="price">₱ 1,500,000</p>
                <p class="title">Rolex GMT-Master II</p>
                <p class="location">by Rolex</p>
                <p class="sqm">40 mm</p>
                <p class="by">Rolex Caliber 3285</p>
            </div>
        </a>
    </div>
</section>

